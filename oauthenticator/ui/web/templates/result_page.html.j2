{% extends 'base.html.j2' %}
{% from 'macros.html.j2' import toolbar, identity_block, tabs, error_block %}

{% block title %}{{ view.title }}{% endblock %}

{% block head %}
<link rel="stylesheet" href="{{ view.paths.css }}">
{% endblock %}

{% block body_attrs %}
 class="{% if view.error is none %}has-grid{% endif %}"
 data-action-token="{{ view.action_token }}"
 data-ping-path="{{ view.paths.ping }}"
 data-ping-interval="{{ ping_interval }}"
 data-quit-path="{{ view.paths.quit }}"
 data-refresh-path="{{ view.paths.refresh }}"
 data-userinfo-path="{{ view.paths.userinfo }}"
 data-introspect-path="{{ view.paths.introspect }}"
 data-revoke-path="{{ view.paths.revoke }}"
{% endblock %}

{% block body %}
<div class="page">
{{ toolbar(view) }}
{% if view.error is not none %}
{{ error_block(view.error, view.paths.root) }}
{% else %}
{{ identity_block(view.identity) }}
{{ tabs(view.tokens, view.extras, view.userinfo) }}
{% endif %}
</div>
<script src="{{ view.paths.js }}"></script>
{% endblock %}
