{# Both ends of the token's life as absolute UTC, which is why nothing here jitters:
   every timestamp is the same character count. The relative form lives in the hover
   tooltip, where it is free to change width. app.js drives the fill, the dot and the
   ramp class; the markup only says where the ends are. #}
{% macro lifetime_bar(lifetime) %}
<div class="life">
<span class="life-stamp">{{ lifetime.start_label }} {{ lifetime.start | format_time }}<span class="life-tip" data-time="{{ lifetime.start | format_epoch }}"></span></span>
<div class="life-track" data-life-start="{{ lifetime.start | format_epoch }}" data-life-end="{{ lifetime.expires_at | format_epoch }}">
<div class="life-fill"></div><div class="life-dot"></div>
</div>
<span class="life-stamp life-exp">exp {{ lifetime.expires_at | format_time }}<span class="life-tip" data-time="{{ lifetime.expires_at | format_epoch }}"></span></span>
</div>
{% endmacro %}


{% macro toolbar(view) %}
<div class="bar">
<button type="button" class="title" id="page-title">$ oauthenticator</button>
<span class="bar-spacer" id="bar-status"></span>
<span class="status-dot live" id="status-dot" role="status" aria-label="CLI running"></span>
{% if view.error is not none %}
<button type="button" class="pill pill-muted" id="btn-refresh" data-label="Refresh" disabled>Refresh</button>
<button type="button" class="pill pill-danger" id="btn-end-session" data-label="End session" disabled>End session</button>
{% else %}
{% if view.session_actions.can_refresh %}
<button type="button" class="pill pill-muted" id="btn-refresh" data-label="Refresh" onclick="refreshTokens(this)">{{ icon_refresh() }}Refresh</button>
{% endif %}
{% if view.session_actions.end_session_url is not none %}
<button type="button" class="pill pill-danger" id="btn-end-session" data-label="End session" data-url="{{ view.session_actions.end_session_url }}" onclick="endSession(this)">{{ icon_logout() }}End session</button>
{% endif %}
{% endif %}
<button type="button" class="pill pill-muted" id="btn-quit" data-label="Quit" onclick="quitCli(this)">{{ icon_power() }}Quit</button>
<button type="button" class="icon-button theme-toggle" id="theme-toggle" onclick="toggleTheme()" aria-label="Toggle theme">{{ icon_sun() }}{{ icon_moon() }}</button>
</div>
{% endmacro %}


{% macro identity_block(identity) %}
<div class="identity">
{% if identity.picture is not none %}
<img class="avatar" src="{{ identity.picture }}" alt="" referrerpolicy="no-referrer" data-initials="{{ identity.initials }}" onerror="avatarFailed(this)">
{% else %}
<div class="avatar avatar-fallback">{{ identity.initials }}</div>
{% endif %}
<div class="who">
<div class="name-line">
<span class="name">{{ identity.name }}</span>
{% if identity.email_verified %}{{ icon_check() }}{% endif %}
{% if identity.email is not none %}<span class="email">{{ identity.email }}</span>{% endif %}
</div>
{% for key, value in identity.facts %}
<div class="fact">{{ key }}&nbsp;&nbsp;{{ value }}</div>
{% endfor %}
</div>
</div>
{% endmacro %}


{% macro extras_panel(extras) %}
{{ json_section('TOKEN RESPONSE EXTRAS', extras) }}
{% endmacro %}


{% macro token_actions(panel) %}
{% if panel.is_id_token %}
<p class="hint">An id_token is not an OAuth token: introspection and revocation do not apply to it.</p>
{% elif panel.can_curl or panel.can_introspect or panel.can_revoke %}
<div class="actions">
{% if panel.can_curl %}
<button type="button" class="pill pill-muted" data-curl="{{ panel.curl_command }}" onclick="copyCurl(this)">{{ icon_terminal() }}Copy as curl</button>
{% endif %}
{% if panel.can_introspect %}
<button type="button" class="pill pill-info" onclick="introspect('{{ panel.name }}')">{{ icon_search() }}Introspect</button>
{% endif %}
{% if panel.can_revoke %}
<button type="button" class="pill pill-danger" onclick="revoke('{{ panel.name }}')">{{ icon_trash() }}Revoke</button>
{% endif %}
</div>
{% endif %}
{% endmacro %}


{# Recursive pretty-printer for already-decoded JSON claims: 2-space indent, keys in
   var(--info), string values in var(--accent), numbers in var(--ok). Keys and string
   values go through the `tojson` filter, not a plain {{ }}, so a value containing a
   quote, backslash or newline still prints as valid JSON syntax instead of breaking
   the pretty-printed layout; `tojson`'s output is autoescape-safe like every other
   expression in this file, so there is still no `|safe` anywhere. #}
{%- macro json_node(value, depth) -%}
{%- if value is mapping -%}
{%- if not value -%}{}{%- else -%}{
{%- for key, item in value.items() -%}
{{ "\n" }}{{ '  ' * (depth + 1) }}<span class="json-key">{{ key | tojson }}</span>: {{ json_node(item, depth + 1) }}{% if not loop.last %},{% endif %}
{%- endfor -%}
{{ "\n" }}{{ '  ' * depth }}}
{%- endif -%}
{%- elif value is sequence and value is not string -%}
{%- if not value -%}[]{%- else -%}[
{%- for item in value -%}
{{ "\n" }}{{ '  ' * (depth + 1) }}{{ json_node(item, depth + 1) }}{% if not loop.last %},{% endif %}
{%- endfor -%}
{{ "\n" }}{{ '  ' * depth }}]
{%- endif -%}
{%- elif value is boolean -%}
<span class="json-string">{{ value | lower }}</span>
{%- elif value is none -%}
<span class="json-string">null</span>
{%- elif value is string -%}
<span class="json-string">{{ value | tojson }}</span>
{%- elif value is number -%}
<span class="json-number">{{ value }}</span>
{%- else -%}
<span class="json-string">{{ value }}</span>
{%- endif -%}
{%- endmacro -%}


{% macro json_section(label, value) %}
<div class="json-label">&mdash; {{ label }} &mdash;</div>
<pre class="json-rail">{{ json_node(value, 0) }}</pre>
{% endmacro %}


{% macro claims(panel) %}
{% if panel.decoded is none %}
<p class="hint">Not a JWT, nothing to decode.</p>
{% else %}
{{ json_section('HEADER', panel.decoded.header) }}
{{ json_section('PAYLOAD', panel.decoded.payload) }}
<div class="json-label">&mdash; SIGNATURE &mdash;</div>
<pre class="json-rail">{{ panel.decoded.signature }}</pre>
{% endif %}
{% endmacro %}


{% macro token_panel(panel) %}
<div class="token-value">
<button type="button" class="chevron-button" title="Expand" onclick="toggleToken(this)">{{ icon_chevron() }}</button>
<code class="value">{{ panel.value }}</code>
<button type="button" class="copy-button" title="Copy" onclick="copyValue(this)">{{ icon_copy() }}</button>
</div>
{% if panel.lifetime is not none %}
{{ lifetime_bar(panel.lifetime) }}
{% endif %}
{{ token_actions(panel) }}
<div class="json-label result-label" hidden></div>
<pre class="result" hidden></pre>
{{ claims(panel) }}
{% endmacro %}


{% macro userinfo_panel(userinfo) %}
<div class="actions">
<button type="button" class="pill pill-muted" onclick="reloadUserinfo()">{{ icon_refresh() }}Fetch again</button>
</div>
<div class="json-label result-label">&mdash; USERINFO &mdash;</div>
{% if userinfo.data is not none %}
<pre class="result json-rail">{{ json_node(userinfo.data, 0) }}</pre>
{% else %}
<pre class="result failed">{{ userinfo.error or 'not fetched yet' }}</pre>
{% endif %}
{% endmacro %}


{# Tab order mirrors the flow: the tokens themselves, then what else the token
   response carried, then what the provider says about the user. The first tab
   that exists is the selected one. #}
{% macro tabs(tokens, extras, userinfo) %}
<nav class="tabs">
{% for panel in tokens %}
<button type="button"{% if loop.first %} class="active"{% endif %} data-tab="{{ panel.name }}" onclick="selectTab('{{ panel.name }}')">{{ panel.name }}</button>
{% endfor %}
{% if extras %}
<button type="button"{% if not tokens %} class="active"{% endif %} data-tab="extras" onclick="selectTab('extras')">extras</button>
{% endif %}
<button type="button"{% if not tokens and not extras %} class="active"{% endif %} data-tab="userinfo" onclick="selectTab('userinfo')">userinfo</button>
</nav>
{% for panel in tokens %}
<section class="panel{% if loop.first %} active{% endif %}{% if panel.revoked %} revoked{% endif %}" data-tab="{{ panel.name }}">
{{ token_panel(panel) }}
</section>
{% endfor %}
{% if extras %}
<section class="panel{% if not tokens %} active{% endif %}" data-tab="extras">
{{ extras_panel(extras) }}
</section>
{% endif %}
<section class="panel{% if not tokens and not extras %} active{% endif %}" data-tab="userinfo">
{{ userinfo_panel(userinfo) }}
</section>
{% endmacro %}


{% macro error_block(error, retry_path) %}
<div class="error-block">
<div class="error-tile">{{ icon_alert_triangle() }}</div>
<div class="error-body">
<div class="error-headline">{{ error.headline }}</div>
{% for line in error.lines %}<div class="error-line">{{ line }}</div>{% endfor %}
<div class="error-source">source: callback</div>
</div>
</div>
<p class="hint"><a href="{{ retry_path }}">try again</a></p>
<pre class="error-detail">{{ error.detail }}</pre>
{% endmacro %}
